#!/usr/bin/env bash

# Enforces the conventional-commit subject format, so that release notes can be
# generated by grouping the commit subjects since the previous release tag.

set -o nounset
set -o pipefail

readonly subject="$(head -n 1 "${1}")"

readonly pattern='^(feat|fix|docs|refactor|test|chore|perf|build|ci|style|revert)(\([^)]+\))?!?: .+'
if [[ "${subject}" =~ ${pattern} ]] \
  || [[ "${subject}" == "Merge "* ]] \
  || [[ "${subject}" == "Revert "* ]] \
  || [[ "${subject}" == "fixup! "* ]] \
  || [[ "${subject}" == "squash! "* ]]; then
  exit 0
fi

echo "ERROR: the commit subject does not follow the conventional-commit format." >&2
echo "  subject: ${subject}" >&2
echo "  expected: <type>(<scope>)?: <description>" >&2
echo "  types: feat fix docs refactor test chore perf build ci style revert" >&2
echo "  example: feat(sfc): try the smallest alternatives first" >&2
exit 1
