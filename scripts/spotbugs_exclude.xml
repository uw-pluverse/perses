    <Class name="org.perses.Main$createSequenceOfReductionDriverCreators$1" />
    <Bug pattern="BC_BAD_CAST_TO_ABSTRACT_COLLECTION" />
  </Match>
  <Match>
    <Class name="org.perses.Main$createSequenceOfReductionDriverCreators$2$2" />
    <Bug pattern="SE_BAD_FIELD" />
  </Match>
</FindBugsFilter>
