    <Class name="org.perses.AbstractMain" />
    <Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS" />
  </Match>
  <Match>
    <Class name="org.perses.CommandOptions" />
    <Bug pattern="EI_EXPOSE_REP" />
  </Match>
